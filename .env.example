# Copy to .env for local development and fill values locally. Do not commit .env.
# Local free-first defaults. Use the full path to the Python 3.12 executable for Task Scheduler.
NEWSLETTER_TIMEZONE=Asia/Kolkata
NEWSLETTER_RECIPIENT=
PYTHON_EXE=
APP_CONFIG_DIR=config
PREVIEW_DIRECTORY=data/previews
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2
LLM_REQUEST_INTERVAL_SECONDS=3.2
LLM_RETRY_MAX_WAIT_SECONDS=8
NEWS_PROVIDER_API_KEY=
# Free local Gmail-compatible SMTP option. Store the app password in Windows Credential Manager
# with `personal-news-agent email-credential-set`; never put it in this file.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
EMAIL_FROM=
EMAIL_TIMEOUT_SECONDS=20
EMAIL_MAX_ATTEMPTS=2
# Optional existing provider, only when EMAIL_PROVIDER=resend. May involve paid services.
RESEND_API_KEY=
