# Python bytecode and environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Packaging and test/tool caches
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local secrets and editor/OS files
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local application state (keep data/.gitkeep)
data/*
!data/.gitkeep
*.sqlite
*.sqlite3
*.db

# Project-local pytest temporary directories used on Windows
.pytest-tmp*/
